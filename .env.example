NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ENKARTA_API_KEY=
ADMIN_PASSWORD=
# Private session signing key; rotate to revoke all sessions.
HOST_SESSION_SECRET=
# Keep manual until BCP supplies the sandbox contract and integration passes tests.
PAYMENT_PROVIDER=manual
# BCP API key is server-only. Never add a NEXT_PUBLIC_ equivalent.
BCP_API_KEY=
# Additional HTTPS image hosts explicitly approved for invitation media, comma-separated.
ENKARTA_IMAGE_HOSTS=
# WhatsApp de contacto de la landing (formato internacional sin +, ej. 59171234567)
NEXT_PUBLIC_WA_PHONE=
# Configuración comercial privada para el panel administrativo.
# ENKARTA_PAYMENT_INSTRUCTIONS también alimenta el panel de socios: banco, número
# de cuenta y titular. Separa las líneas con " | " (se muestran una por renglón).
ENKARTA_PAYMENT_INSTRUCTIONS=
ENKARTA_SALES_HOURS=Lunes a sábado · 09:00–19:00
# Imagen del QR bancario que ve el socio al pagar su mensualidad (URL pública)
NEXT_PUBLIC_ENKARTA_PAYMENT_QR=
# Medición opcional: no se carga sin consentimiento del visitante
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Dominio canónico; por ahora puede conservar https://enkarta.vercel.app
NEXT_PUBLIC_SITE_URL=
